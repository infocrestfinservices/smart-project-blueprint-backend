```gitignore
# ==========================
# Python
# ==========================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ==========================
# Virtual Environment
# ==========================
venv/
.venv/
env/
ENV/

# ==========================
# Environment Variables
# ==========================
.env
.env.*
!.env.example

# ==========================
# FastAPI
# ==========================
*.log

# ==========================
# Database
# ==========================
*.db
*.sqlite
*.sqlite3

# ==========================
# Caches
# ==========================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.cache/

# ==========================
# Coverage
# ==========================
.coverage
.coverage.*
htmlcov/
coverage.xml

# ==========================
# Build / Distribution
# ==========================
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ==========================
# IDEs
# ==========================
.vscode/
.idea/
*.swp
*.swo

# ==========================
# OS Files
# ==========================
.DS_Store
Thumbs.db

# ==========================
# Jupyter
# ==========================
.ipynb_checkpoints/

# ==========================
# PyInstaller
# ==========================
*.manifest
*.spec

# ==========================
# Logs
# ==========================
logs/
*.log

# ==========================
# Temporary Files
# ==========================
tmp/
temp/

# ==========================
# Secrets / Keys
# ==========================
*.pem
*.key
*.crt

# ==========================
# Local Testing
# ==========================
.pytest_cache/
.tox/
.nox/

# ==========================
# Misc
# ==========================
*.bak
*.orig
```
